# Copy to backend/.env, which is ignored. Never paste live secrets into chat.
NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=0

# Generate a private random secret (32+ characters). Required by Compose;
# production rejects missing, short, repetitive, and placeholder secrets.
JWT_SECRET=

# Production: use the Neon connection string as DATABASE_URL. The application
# enforces verified TLS even when the provider URL contains sslmode=require.
# Leave empty when using the local PG* settings below.
DATABASE_URL=

# Local Compose database: no database port is published to the host.
# PGHOST is overridden to db inside the backend container.
PGHOST=localhost
PGPORT=5432
PGUSER=autoluxe
PGPASSWORD=
PGDATABASE=autoluxe
PGSSL=false
PGPOOL_MAX=5
